# CardioGuard — environment configuration (copy to .env)
#
# Leave EXPO_PUBLIC_API_URL unset to run fully offline (local AsyncStorage only).
# When set, the app syncs through a REST backend in offline-first mode: local
# storage stays the offline source of truth, the backend is synced best-effort.
#
# Backend contract (whole-state document):
#   GET    {EXPO_PUBLIC_API_URL}/state  -> 200 PersistedState | 404
#   PUT    {EXPO_PUBLIC_API_URL}/state  <- PersistedState  -> 2xx
#   DELETE {EXPO_PUBLIC_API_URL}/state                     -> 2xx

# EXPO_PUBLIC_API_URL=https://api.cardioguard.example.com
# EXPO_PUBLIC_API_TIMEOUT_MS=10000
# EXPO_PUBLIC_API_RETRIES=2
